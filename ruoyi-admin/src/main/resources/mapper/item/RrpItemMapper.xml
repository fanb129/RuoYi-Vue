<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.item.mapper.RrpItemMapper">
    
    <resultMap type="RrpItem" id="RrpItemResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="categoryId"    column="category_id"    />
        <result property="price"    column="price"    />
        <result property="description"    column="description"    />
        <result property="image"    column="image"    />
        <result property="type"    column="type"    />
        <result property="status"    column="status"    />
        <result property="userId"    column="user_id"    />
        <result property="categoryName"    column="category_name"    />
        <result property="userNickName"    column="user_nick_name"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectRrpItemVo">
        select i.id, i.name, i.category_id, i.price, i.description, i.image, i.type, i.status, i.user_id, i.create_time,
               c.name as category_name,
               u.nick_name as user_nick_name
        from rrp_item i
        left join rrp_category c on i.category_id = c.id
        left join sys_user u on i.user_id = u.user_id
    </sql>

    <select id="selectRrpItemList" parameterType="RrpItem" resultMap="RrpItemResult">
        <include refid="selectRrpItemVo"/>
        <where>  
            <if test="name != null  and name != ''"> and i.name like concat('%', #{name}, '%')</if>
            <if test="categoryId != null "> and i.category_id = #{categoryId}</if>
            <if test="price != null "> and i.price = #{price}</if>
            <if test="description != null  and description != ''"> and i.description = #{description}</if>
            <if test="image != null  and image != ''"> and i.image = #{image}</if>
            <if test="type != null  and type != ''"> and i.type = #{type}</if>
            <if test="status != null  and status != ''"> and i.status = #{status}</if>
            <if test="userId != null "> and i.user_id = #{userId}</if>
        </where>
    </select>
    
    <select id="selectRrpItemById" parameterType="Long" resultMap="RrpItemResult">
        <include refid="selectRrpItemVo"/>
        where i.id = #{id}
    </select>

    <insert id="insertRrpItem" parameterType="RrpItem" useGeneratedKeys="true" keyProperty="id">
        insert into rrp_item
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">name,</if>
            <if test="categoryId != null">category_id,</if>
            <if test="price != null">price,</if>
            <if test="description != null">description,</if>
            <if test="image != null">image,</if>
            <if test="type != null">type,</if>
            <if test="status != null">status,</if>
            <if test="userId != null">user_id,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">#{name},</if>
            <if test="categoryId != null">#{categoryId},</if>
            <if test="price != null">#{price},</if>
            <if test="description != null">#{description},</if>
            <if test="image != null">#{image},</if>
            <if test="type != null">#{type},</if>
            <if test="status != null">#{status},</if>
            <if test="userId != null">#{userId},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateRrpItem" parameterType="RrpItem">
        update rrp_item
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="price != null">price = #{price},</if>
            <if test="description != null">description = #{description},</if>
            <if test="image != null">image = #{image},</if>
            <if test="type != null">type = #{type},</if>
            <if test="status != null">status = #{status},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteRrpItemById" parameterType="Long">
        delete from rrp_item where id = #{id}
    </delete>

    <delete id="deleteRrpItemByIds" parameterType="String">
        delete from rrp_item where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>