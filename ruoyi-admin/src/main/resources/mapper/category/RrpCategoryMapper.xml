<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.category.mapper.RrpCategoryMapper">
    
    <resultMap type="RrpCategory" id="RrpCategoryResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
    </resultMap>

    <sql id="selectRrpCategoryVo">
        select id, name from rrp_category
    </sql>

    <select id="selectRrpCategoryList" parameterType="RrpCategory" resultMap="RrpCategoryResult">
        <include refid="selectRrpCategoryVo"/>
        <where>  
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
        </where>
    </select>
    
    <select id="selectRrpCategoryById" parameterType="Long" resultMap="RrpCategoryResult">
        <include refid="selectRrpCategoryVo"/>
        where id = #{id}
    </select>

    <insert id="insertRrpCategory" parameterType="RrpCategory" useGeneratedKeys="true" keyProperty="id">
        insert into rrp_category
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">name,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">#{name},</if>
         </trim>
    </insert>

    <update id="updateRrpCategory" parameterType="RrpCategory">
        update rrp_category
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null and name != ''">name = #{name},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteRrpCategoryById" parameterType="Long">
        delete from rrp_category where id = #{id}
    </delete>

    <delete id="deleteRrpCategoryByIds" parameterType="String">
        delete from rrp_category where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>